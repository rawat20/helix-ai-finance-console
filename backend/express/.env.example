# Copy to backend/express/.env for local development

DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker?schema=public"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
PORT=4000
JWT_SECRET_KEY=generate-a-random-32-char-string-here
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Production (Railway): set NODE_ENV=production and your Vercel URL(s)
# NODE_ENV=production
# FRONTEND_URL=https://your-app.vercel.app
# FRONTEND_URL_PREVIEW=https://your-app-git-branch-team.vercel.app
